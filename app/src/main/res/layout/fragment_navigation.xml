<?xml version="1.0" encoding="utf-8"?>
<!--
  ③ 안내 — Figma 「09 안내 중」 / 「10 위험 경고」 / 「11 경로 이탈」

  세 프레임은 같은 화면의 상태 차이다. nav_card 의 배경만 갈아끼우면 위험 표시가 된다.
  안내 문구는 포커스에서 제외하고 자동 발화만 한다. 포커스에 넣으면 TalkBack이 중복해서 읽는다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="@dimen/screen_pad_top"
    android:paddingBottom="@dimen/screen_pad_bottom">

    <LinearLayout
        android:id="@+id/nav_card"
        style="@style/Card.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/pad_hero_mid"
        android:paddingBottom="@dimen/pad_hero_mid"
        android:importantForAccessibility="no">

        <ImageView
            android:id="@+id/nav_icon"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="@null" />

        <!--
          자동 발화만 하고 포커스에서 뺀다. 포커스에 넣으면 TalkBack이 같은 문장을 또 읽는다.
          화면에 뿌리는 문자열에는 줄바꿈 금지 문자가 섞여 있어 읽히면 안 되기도 한다.
        -->
        <TextView
            android:id="@+id/instruction_text"
            style="@style/Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hero_wide"
            android:text="@string/nav_routing"
            android:importantForAccessibility="no" />

        <!-- 진행 표시. 남은 구간이 몇 개인지 보이는 사용자에게만 쓸모가 있다. -->
        <LinearLayout
            android:id="@+id/progress_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hero_wide"
            android:orientation="horizontal" />
    </LinearLayout>

    <LinearLayout
        style="@style/Card.Sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/screen_gap"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/beacon_debug"
            style="@style/Text.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/progress_sub"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_text"
            android:text="@string/nav_progress_sub" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
      검정 알약. 안내 중에 화면을 보지 않고 누르는 곳이라 두 칸으로만 나눈다.
      셋 이상이면 어느 칸인지 손끝으로 가늠할 수 없다.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_bar"
        android:padding="5dp">

        <TextView
            android:id="@+id/btn_replay"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="@dimen/pill_height"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_pill_white"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/nav_replay"
            android:contentDescription="@string/nav_replay_desc" />

        <TextView
            android:id="@+id/btn_stop"
            style="@style/Text.Title"
            android:layout_width="0dp"
            android:layout_height="@dimen/pill_height"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:gravity="center"
            android:textColor="@color/bar_text_off"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/nav_stop"
            android:contentDescription="@string/nav_stop_desc" />
    </LinearLayout>

</LinearLayout>
