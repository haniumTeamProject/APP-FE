<?xml version="1.0" encoding="utf-8"?>
<!--
  ④ 도착 — Figma 「14 도착 · ARRIVED」
  도착 발화 후 바로 닫지 않는다. 사용자가 아직 문을 찾지 못했을 수 있다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="@dimen/screen_pad_top"
    android:paddingBottom="@dimen/screen_pad_bottom">

    <LinearLayout
        style="@style/Card.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/pad_hero_tall"
        android:paddingBottom="@dimen/pad_hero_tall"
        android:importantForAccessibility="no">

        <FrameLayout
            android:layout_width="@dimen/check_size"
            android:layout_height="@dimen/check_size"
            android:background="@drawable/circle_blue">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/arrival_text"
            style="@style/Text.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hero_wide" />

        <TextView
            android:id="@+id/arrival_hint"
            style="@style/Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hero_wide" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/tile_height"
        android:layout_marginTop="@dimen/screen_gap"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btn_new_dest"
            style="@style/Tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_tile_mint"
            android:contentDescription="@string/arrive_new_desc">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arrive_new"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_text"
                android:textColor="@color/on_mint"
                android:text="@string/arrive_new_sub"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_end"
            style="@style/Tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/gap_tile"
            android:background="@drawable/bg_tile_gray"
            android:contentDescription="@string/arrive_end_desc">

            <TextView
                style="@style/Text.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/arrive_end"
                android:importantForAccessibility="no" />

            <TextView
                style="@style/Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_text"
                android:text="@string/arrive_end_sub"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
