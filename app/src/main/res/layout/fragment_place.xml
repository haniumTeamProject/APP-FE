<?xml version="1.0" encoding="utf-8"?>
<!--
  건물·층 선택 — 앱 진입점 (Figma 「19 건물·층 선택」)

  1차는 자동 인식이 없으므로 사용자가 직접 고른다. 화면을 못 보는 사용자를 위해
  목록 첫 항목에 포커스를 강제로 옮기고, 진입 안내를 발화한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screen_bg"
    android:paddingStart="@dimen/screen_pad_h"
    android:paddingEnd="@dimen/screen_pad_h"
    android:paddingTop="@dimen/screen_pad_top"
    android:paddingBottom="@dimen/screen_pad_bottom">

    <!--
      머리말. 자식 텍스트는 통째로 숨긴다("no"만 쓰면 안쪽 텍스트가 새어 읽힌다).
      건물 선택 화면에서는 이 머리말이 사용법 재열람(길게 누르기·접근성 액션)의 진입점이 된다 —
      아래는 스크롤 목록이라 빈 곳을 길게 누를 자리가 없기 때문이다. FloorFragment 는 붙이지 않는다.
    -->
    <LinearLayout
        android:id="@+id/place_header"
        style="@style/Card.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="noHideDescendants">

        <TextView
            android:id="@+id/place_title"
            style="@style/Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/place_title" />

        <TextView
            android:id="@+id/place_sub"
            style="@style/Text.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_hero"
            android:text="@string/place_sub" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/screen_gap"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/place_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
