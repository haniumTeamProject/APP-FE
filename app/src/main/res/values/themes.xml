<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.APPFE" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="Theme.APPFE" parent="Base.Theme.APPFE" />

    <!--
      큰 버튼. 최소 높이를 화면 1/3 수준으로 잡아 조준 없이 누를 수 있게 한다.
      실제 비율은 각 레이아웃의 layout_weight 로 정한다.
    -->
    <style name="BigButton">
        <item name="android:background">@color/accent</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="SubButton" parent="BigButton">
        <item name="android:background">@color/surface</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textSize">26sp</item>
    </style>

</resources>
