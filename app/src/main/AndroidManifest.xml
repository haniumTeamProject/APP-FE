<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- BLE 스캔 — server/bleapp 과 똑같이 맞췄다.
         두 앱이 같은 폰에서 같은 비콘을 보는데 한쪽만 잡히면 차이는 여기다.

         neverForLocation 을 붙이면 안 된다. "위치 추적에 안 쓰겠다"는 선언인데,
         안드로이드가 그 약속을 강제하느라 위치를 유추할 수 있는 광고를 걸러낸다.
         그러면 주변 가전은 다 보이는데 우리 비콘만 안 잡힌다.
         이 앱은 비콘으로 실내 위치를 정하는 것이 본래 목적이라 그 선언이 맞지 않는다. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- API 30 이하 호환 -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- 위치 권한. **maxSdkVersion 을 걸지 않는다.**
         neverForLocation 을 뺀 이상 BLE 스캔 결과를 위치 정보로 취급하므로,
         API 31+ 에서도 이 권한이 있어야 광고가 걸러지지 않는다.
         maxSdkVersion="30" 이면 그 위 버전에서는 선언조차 안 되어 요청할 수도 없다. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 음성 입력 (SpeechRecognizer) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      진동. 없으면 Vibrator.vibrate 가 SecurityException 을 던져 앱이 죽는다.
      런타임 요청이 필요 없는 일반 권한이라 선언만 하면 된다.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 서버 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 안내 중 BLE 스캔 유지. 없으면 화면을 끄는 순간 스캔이 중단된다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- BLE 미지원 기기 설치 차단하지 않음 (런타임에 확인) -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- SpeechRecognizer 가시성 (API 30+ 패키지 가시성 제한 대응) -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.APPFE">
        <!--
          세로 고정 + config 변경 자체 처리.

          회전·다크모드·글씨크기 변경은 기본적으로 Activity 를 재생성하는데,
          그러면 선택한 건물·층·목적지·경로가 전부 초기화되고 복원된 화면과 어긋난다.
          이 앱은 시각장애인이 걸으며 쓰는 세로 전용이라 가로가 필요 없으므로,
          세로로 잠그고 config 변경은 재생성 없이 넘긴다(상태 유지).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|fontScale|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>